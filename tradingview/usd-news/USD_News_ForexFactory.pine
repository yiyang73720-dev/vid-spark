// ═══ Per-bar state ═══════════════════════════════════════════════════════════
// Renko, range and tick charts have no time_close for the open realtime bar;
// judge that bar by the current time instead.
bool openEnded = na(time_close) and barstate.isrealtime
int  barStart  = openEnded ? math.max(time, timenow) : time
int  barEnd    = openEnded ? barStart + 1 : nz(time_close, time + timeframe.in_seconds() * 1000)

// Merged windows are disjoint and sorted, so one forward-moving pointer is enough.
var int wPtr = 0
while wPtr < winStart.size() and winEnd.get(wPtr) <= barStart
    wPtr += 1
bool inWinBar = wPtr < winStart.size() and winStart.get(wPtr) < barEnd
int  winLvl   = inWinBar ? winLevel.get(wPtr) : -1

var int cPtr = 0
while cPtr < clTime.size() and clTime.get(cPtr) < time
    if na(clY.get(cPtr))    // released while there were no bars (session gap): pin to this bar
        clY.set(cPtr, high)
    cPtr += 1
int j = cPtr
while j < clTime.size() and clTime.get(j) < barEnd
    clY.set(j, high)
    j += 1
float minsToNext = cPtr < clTime.size() ? (clTime.get(cPtr) - time) / 60000.0 : na

levelColor(int lvl) =>
    lvl == 3 ? colHigh : lvl == 2 ? colMed : lvl == 1 ? colLow : colHol

bool shadeOn = doShade and (timeframe.isintraday or not shadeIntra)
bgcolor(shadeOn and inWinBar ? color.new(levelColor(winLvl), shadeTr) : na, title = "新闻窗口背景", editable = false)

// For other scripts (input.source) and the Data Window.
plot(inWinBar ? 1 : 0, "USD news window (1 = inside)", display = display.data_window, editable = false)
plot(minsToNext, "Minutes to next USD news", display = display.data_window, editable = false)

bool inAlertWin = inWinBar and winLvl >= alertMin
alertcondition(inAlertWin and not inAlertWin[1], "USD 新闻窗口开始", "{{ticker}}: USD 新闻窗口开始，暂停交易")
alertcondition(not inAlertWin and inAlertWin[1], "USD 新闻窗口结束", "{{ticker}}: USD 新闻窗口结束")

// ═══ Formatting helpers ══════════════════════════════════════════════════════
var array<string> DAYS = array.from("周日", "周一", "周二", "周三", "周四", "周五", "周六")

// Weekday of t in the display time zone, taken from the formatted local date.
dayName(int t) =>
    string d = str.format_time(t, "yyyy-MM-dd", TZ)
    int u = timestamp("UTC", int(str.tonumber(str.substring(d, 0, 4))), int(str.tonumber(str.substring(d, 5, 7))), int(str.tonumber(str.substring(d, 8, 10))), 0, 0)
    DAYS.get(dayofweek(u, "UTC") - 1)

fmtWhen(int t, bool allDay) =>
    string day = dayName(t) + " " + str.format_time(t, "MM-dd", TZ)
    allDay ? day + " 全天" : day + " " + str.format_time(t, "HH:mm", TZ)

// Rated items without a fixed time are "tentative": they can land any time that day.
whenText(NewsEvent e) =>
    e.allDay and e.level > 0 ? fmtWhen(e.t, true) + "/待定" : fmtWhen(e.t, e.allDay)

fmtDur(int ms) =>
    int m = int(math.ceil(ms / 60000.0))
    string out = ""
    if m <= 0
        out := "现在"
    else if m < 60
        out := str.tostring(m) + "分"
    else if m < 1440
        out := str.tostring(int(m / 60)) + "小时" + (m % 60 > 0 ? str.tostring(m % 60) + "分" : "")
    else
        out := str.tostring(int(m / 1440)) + "天" + str.tostring(int((m % 1440) / 60)) + "小时"
    out

titleOf(string title) =>
    string out = title
    if langIn != "English"
        string zh = ZH.get(title)
        if na(zh) and (str.endswith(title, " Speaks") or str.endswith(title, " Testifies"))
            zh := str.replace_all(str.replace_all(title, " Speaks", " 讲话"), " Testifies", " 国会作证")
            zh := str.replace(zh, "Fed Vice Chair for Supervision ", "美联储负责监管的副主席 ", 0)
            zh := str.replace(zh, "Fed Chair ", "美联储主席 ", 0)
            zh := str.replace(zh, "Fed Vice Chair ", "美联储副主席 ", 0)
            zh := str.replace(zh, "FOMC Member ", "FOMC 委员 ", 0)
            zh := str.replace(zh, "Treasury Secretary ", "财长 ", 0)
            zh := str.replace(zh, "Treasury Sec ", "财长 ", 0)
            zh := str.replace(zh, "President ", "总统 ", 0)
        if not na(zh)
            out := langIn == "中文" ? zh : zh + " " + title
    out

// Event name as shown; with several currencies the currency code goes first.
evName(NewsEvent e) =>
    (multiCcy and e.currency != "" ? e.currency + " " : "") + titleOf(e.title)

levelDot(int lvl) =>
    lvl == 3 ? "🔴" : lvl == 2 ? "🟠" : lvl == 1 ? "🟡" : "⚪"

levelName(int lvl) =>
    lvl == 3 ? "高" : lvl == 2 ? "中" : lvl == 1 ? "低" : "假日"

fcstText(NewsEvent e) =>
    string out = ""
    if e.actual != ""
        out += " 实际 " + e.actual
    if e.forecast != ""
        out += " 预测 " + e.forecast
    if e.previous != ""
        out += " 前值 " + e.previous
    out

// Index of the merged window containing t, or -1.
windowAt(int t) =>
    int res = -1
    for [i, s] in winStart
        if s > t
            break
        if t < winEnd.get(i)
            res := i
            break
    res

// Index of the first window starting after t, or -1.
windowAfter(int t) =>
    int res = -1
    for [i, s] in winStart
        if s > t
            res := i
            break
    res

// ═══ Drawings (rebuilt on the last bar) ══════════════════════════════════════
float refHigh = ta.highest(high, 20)
float pad     = nz(ta.atr(14), high - low)

var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()

if barstate.islast
    for l in drawnLines
        l.delete()
    drawnLines.clear()
    for lb in drawnLabels
        lb.delete()
    drawnLabels.clear()

    int fromT = NOW - lookback * 86400000
    // Labels of releases close together are stacked on up to three levels.
    int gap   = math.max(timeframe.in_seconds(), 60) * 1000 * 30
    int stack = 0
    int prevT = na
    for [ci, ct] in clTime
        if ct >= fromT
            stack := not na(prevT) and ct - prevT < gap ? (stack + 1) % 3 : 0
            prevT := ct
            int   lvl = clLevel.get(ci)
            color c   = levelColor(lvl)
            if doLines
                drawnLines.push(line.new(ct, close, ct, close + syminfo.mintick, xloc.bar_time, extend.both, color.new(c, 30), line.style_solid, lvl == 3 ? 2 : 1))
            if labelMode != "关闭"
                string txt = str.format_time(ct, "HH:mm", TZ)
                string tip = fmtWhen(ct, false)
                int shown = 0
                int more  = 0
                int k = clFirst.get(ci)
                while k < events.size() and events.get(k).t == ct
                    NewsEvent e = events.get(k)
                    if not e.allDay
                        tip += "\n" + levelDot(e.level) + " " + evName(e) + fcstText(e)
                        if labelMode == "详细" or shown == 0
                            txt += "\n" + levelDot(e.level) + " " + evName(e) + (labelMode == "详细" ? fcstText(e) : "")
                            shown += 1
                        else
                            more += 1
                    k += 1
                if more > 0
                    txt += "  +" + str.tostring(more)
                float y = (na(clY.get(ci)) ? refHigh + pad : clY.get(ci) + pad * 0.5) + stack * pad * 2
                drawnLabels.push(label.new(ct, y, txt, xloc.bar_time, yloc.price, c, label.style_label_down, lvl <= 1 ? color.black : color.white, labelSize, text.align_left, tip))
    if doWinLines
        for [wi, ws] in winStart
            int we = winEnd.get(wi)
            if we > time and ws >= fromT
                color c = color.new(levelColor(winLevel.get(wi)), 20)
                drawnLines.push(line.new(ws, close, ws, close + syminfo.mintick, xloc.bar_time, extend.both, c, line.style_dashed, 1))
                drawnLines.push(line.new(we, close, we, close + syminfo.mintick, xloc.bar_time, extend.both, c, line.style_dashed, 1))

// ═══ Table ═══════════════════════════════════════════════════════════════════
tablePosition(string p) =>
    switch p
        "右上" => position.top_right
        "右下" => position.bottom_right
        "左上" => position.top_left
        "左下" => position.bottom_left
        "中上" => position.top_center
        => position.bottom_center

var table tbl = na

if barstate.islast and showTable
    int  nowT  = NOW
    int  nCols = showFcst ? 6 : 4
    color bg     = color.new(#131722, 5)
    color fg     = color.new(#D1D4DC, 0)
    color dim    = color.new(#787B86, 0)
    if not na(tbl)
        tbl.delete()
    tbl := table.new(tablePosition(tablePos), nCols, tableRows + 4, bgcolor = bg, frame_color = color.new(#363A45, 0), frame_width = 1, border_color = color.new(#2A2E39, 0), border_width = 1)

    // Row 0: title.
    tbl.cell(0, 0, CCY + " 新闻 · Forex Factory", text_color = fg, text_size = tableSize, text_halign = text.align_left)
    tbl.merge_cells(0, 0, nCols - 1, 0)

    // Row 1: can I trade right now?
    bool   ffDone = na(ffLast) or ffLast <= nowT
    int    wNow = windowAt(nowT)
    int    wNext = windowAfter(nowT)
    string status = ""
    color  statusBg = color.new(#089981, 20)
    if events.size() == 0
        status   := parsedCount > 0 ? "⚠️ 数据里的事件都被「新闻屏蔽窗口」里的显示开关隐藏了" : embeddedCount > 0 ? "⚠️ 内置数据的货币是 " + FF_CURRENCIES + "，和「货币」设置（" + CCY + "）不一致，请改成相同的值" : "⚠️ 还没有数据：把 Forex Factory JSON 粘贴到设置里，或运行 ff_usd_news.py"
        statusBg := color.new(#FF9800, 20)
    else if wNow >= 0
        status   := "⛔ 新闻窗口中，暂停交易 · 至 " + str.format_time(winEnd.get(wNow), "HH:mm", TZ) + "（还剩 " + fmtDur(winEnd.get(wNow) - nowT) + "）"
        statusBg := color.new(levelColor(winLevel.get(wNow)), 20)
    else if ffDone
        // Forex Factory data is used up: nothing is known about what comes next.
        status   := na(ffLast) ? "⚠️ 没有 Forex Factory 数据（只有自定义事件）· 请粘贴本周 JSON 或运行 ff_usd_news.py" : "⚠️ 已加载的 Forex Factory 新闻都已过去，后面有没有新闻未知 · 新一周数据出来后请更新"
        statusBg := color.new(#FF9800, 20)
    else if wNext >= 0 and winStart.get(wNext) - nowT <= alertLead * 60000
        status   := "⚠️ " + fmtDur(winStart.get(wNext) - nowT) + "后进入新闻窗口（" + str.format_time(winStart.get(wNext), "HH:mm", TZ) + "–" + str.format_time(winEnd.get(wNext), "HH:mm", TZ) + "）"
        statusBg := color.new(#FF9800, 20)
    else if wNext >= 0
        status   := "✅ 可交易 · 下个窗口 " + fmtWhen(winStart.get(wNext), false) + "（" + fmtDur(winStart.get(wNext) - nowT) + "后）"
    else
        status   := "✅ 可交易 · 已加载的数据里没有后续新闻窗口"
    tbl.cell(0, 1, status, text_color = color.white, bgcolor = statusBg, text_size = tableSize, text_halign = text.align_left)
    tbl.merge_cells(0, 1, nCols - 1, 1)

    // Row 2: header.
    array<string> heads = showFcst ? array.from("时间", "影响", "事件", "预测", "前值", "倒计时") : array.from("时间", "影响", "事件", "倒计时")
    for [hc, h] in heads
        tbl.cell(hc, 2, h, text_color = dim, text_size = tableSize)

    // Upcoming events (kept until their window ends).
    int row = 3
    for e in events
        int endT = e.allDay ? e.t + 86400000 : e.t + math.max(postOf(e), 1) * 60000
        if endT > nowT and row < tableRows + 3
            bool live = e.t <= nowT
            color c = levelColor(e.level)
            tbl.cell(0, row, whenText(e), text_color = live ? color.white : fg, bgcolor = live ? color.new(c, 40) : na, text_size = tableSize, text_halign = text.align_left)
            tbl.cell(1, row, levelName(e.level), text_color = e.level <= 1 ? color.black : color.white, bgcolor = color.new(c, 0), text_size = tableSize)
            tbl.cell(2, row, (e.major ? "⭐ " : "") + evName(e), text_color = fg, text_size = tableSize, text_halign = text.align_left)
            if showFcst
                tbl.cell(3, row, e.forecast, text_color = fg, text_size = tableSize)
                tbl.cell(4, row, e.previous, text_color = dim, text_size = tableSize)
            string cd = e.allDay ? (live ? "今天" : fmtDur(e.t - nowT)) : live ? "进行中" : fmtDur(e.t - nowT)
            tbl.cell(nCols - 1, row, cd, text_color = live ? color.white : fg, bgcolor = live ? color.new(c, 40) : na, text_size = tableSize)
            row += 1

    // Footer: data freshness.
    string foot = "共 " + str.tostring(events.size()) + " 条"
    if not na(ffLast)
        foot += " · 数据至 " + str.format_time(ffLast, "MM-dd", TZ)
    if FF_UPDATED != ""
        foot += " · 更新于 " + FF_UPDATED
    color footColor = dim
    if events.size() > 0 and ffDone
        foot := "⚠️ 数据已用完 · " + foot
        footColor := color.new(#FF9800, 0)
    tbl.cell(0, row, foot, text_color = footColor, text_size = size.tiny, text_halign = text.align_left)
    tbl.merge_cells(0, row, nCols - 1, row)

// ═══ Alerts (realtime) ═══════════════════════════════════════════════════════
// An alert keeps the script version and inputs it was created with, so it
// never sees later data updates; it says so once its data has run out.
varip int  lastWarned  = 0      // release time already announced
varip int  lastWin     = -2     // window index at the previous tick (-1 = outside)
varip bool staleWarned = false

if barstate.isrealtime
    int nowT = timenow
    // Heads-up N minutes before the no-trade window of each important release.
    // Clusters are sorted, so lastWarned works as a high-water mark.
    for [ci, ct] in clTime
        if ct > nowT and ct > lastWarned and clLevel.get(ci) >= alertMin
            int wi = windowAt(ct)
            if wi < 0
                wi := windowAt(ct - 1)    // post = 0: the window ends exactly at the release
            int ws = wi >= 0 ? math.min(winStart.get(wi), ct) : ct
            if ws - nowT <= alertLead * 60000
                string msg = syminfo.ticker + " · " + (ws > nowT ? fmtDur(ws - nowT) + "后进入 USD 新闻窗口（" + str.format_time(ws, "HH:mm", TZ) + " 起），" + fmtWhen(ct, false) + " 公布：" : fmtDur(ct - nowT) + "后公布 USD 新闻（" + fmtWhen(ct, false) + "）：")
                int k = clFirst.get(ci)
                while k < events.size() and events.get(k).t == ct
                    NewsEvent e = events.get(k)
                    if not e.allDay
                        msg += "\n" + levelDot(e.level) + " " + evName(e) + fcstText(e)
                    k += 1
                alert(msg, alert.freq_all)
                lastWarned := ct
    // Entering / leaving a no-trade window.
    int wNow = windowAt(nowT)
    if alertWin and wNow != lastWin
        if wNow >= 0 and winLevel.get(wNow) >= alertMin
            alert(syminfo.ticker + " · ⛔ USD 新闻窗口开始，暂停交易至 " + str.format_time(winEnd.get(wNow), "HH:mm", TZ), alert.freq_all)
        else if wNow < 0 and lastWin >= 0 and winLevel.get(lastWin) >= alertMin
            alert(syminfo.ticker + " · ✅ USD 新闻窗口结束，可以交易", alert.freq_all)
    lastWin := wNow
    // Forex Factory data used up (or never loaded) in this alert: after the last item and its window.
    if not staleWarned and (na(ffLast) or (ffLast <= nowT and wNow < 0))
        alert(syminfo.ticker + " · ⚠️ 这个警报里的新闻数据已经用完" + (na(ffLast) ? "" : "（数据至 " + str.format_time(ffLast, "MM-dd", TZ) + "）") + "。新一周数据出来后请更新数据，然后删除并重新创建警报。", alert.freq_all)
        staleWarned := true
